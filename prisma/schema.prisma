generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  books Book[]
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  price       Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  authorId    Int
  author      Author   @relation(fields: [authorId], references: [id])
}
